# Open AI Agent Cloud Backend Environment Variables
PORT=8080
NODE_ENV=production
WORKSPACE_DIR=./workspace

# Model Provider Secrets (Configure via server environment or Secrets Manager)
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (for third-party model routing)
OPENAI_API_KEY=

# Optional: xAI Grok API Key
XAI_API_KEY=

# Security & Tenant Isolation Secret
BACKEND_AUTH_SECRET=your_secret_bearer_token_here
